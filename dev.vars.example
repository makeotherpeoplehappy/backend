# Copy to dev.vars for local development and fill in TEST values.
# dev.vars is ignored by git. Real values live only in the Webflow Cloud
# app settings for each environment (Test and Live).

ENVIRONMENT=test
ALLOWED_ORIGINS=http://localhost:4321,https://happiness-foundation.webflow.io

